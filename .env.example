# Copy to .env to override the defaults defined in docker-compose.yml.
# Every variable is optional: docker compose up works without a .env file.

# Database container
POSTGRES_DB=landmarket
POSTGRES_USER=landmarket
POSTGRES_PASSWORD=landmarket
# Host port mapped to the database container (5432 inside the container)
POSTGRES_PORT=15432

# Host ports of the API and the web app containers
API_PORT=8080
WEB_PORT=3000

# Spring profiles of the API container. demo loads sample lots around Natal; leave empty to start
# with an empty database
SPRING_PROFILES_ACTIVE=demo

# Search and listing limits of the API
LAND_LOT_MAX_SEARCH_RADIUS_METERS=50000
LAND_LOT_MAX_BBOX_RESULTS=500

# Access tokens. The secret signs them (HS256, at least 32 bytes): the default is for development
# only, any deployment must set its own. The expiration is an ISO 8601 duration
JWT_SECRET=dev-only-secret-change-me-before-any-deployment
JWT_EXPIRATION=PT2H

# Backend (read by application.yml when running the API outside Docker)
DB_URL=jdbc:postgresql://localhost:15432/landmarket
DB_USERNAME=landmarket
DB_PASSWORD=landmarket
# Browser origins allowed to call the API (comma separated); the default is the Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173
